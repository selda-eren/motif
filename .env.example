MODEL_API_KEY=
# Optional overrides
# MOTIF_MODEL=muse-spark-1.3               # Standard mode: your content is not used for training
# MOTIF_API_BASE=https://api.meta.ai/v1
# MOTIF_REASONING_EFFORT=medium            # low | medium | high (Muse Spark does not accept "none")
